# Pinpoint API -----------------------------------------------------------
# Subdomain you log in with: https://<subdomain>.pinpointhq.com (label only, no dots)
PINPOINT_SUBDOMAIN=your-subdomain
# API key: Settings > API & Webhooks > API Keys. Grant READ permissions only.
# Never commit the real value.
PINPOINT_API_KEY=changeme
PINPOINT_TIMEOUT_SECONDS=30
# page[size]: default 100, max 1000 per the OpenAPI spec
PINPOINT_PAGE_SIZE=100
# Hard ceiling on pages per discovery run. `discover --max-pages N` above it is
# rejected explicitly; a run stopped before the end is reported as PARTIAL.
PINPOINT_MAX_PAGES=200
# Pause between consecutive pages (rate limits are undocumented)
PINPOINT_PAGE_DELAY_SECONDS=0.5
# Retries for 429 / 502 / 503 / 504 / network errors (exponential backoff + jitter)
PINPOINT_MAX_RETRIES=3
PINPOINT_BACKOFF_BASE_SECONDS=1
PINPOINT_BACKOFF_MAX_SECONDS=30

# Safety switch: must stay true. The tool refuses to start otherwise.
READ_ONLY=true

# Experiment -------------------------------------------------------------
# Optional. Only used by single-application commands (inspect, snapshot-*,
# probe-user-scorecards). `discover` ignores it.
APPLICATION_ID=
# Local folder for technical-metadata snapshots (git-ignored)
SNAPSHOT_DIR=snapshots
# Local SQLite state used by poll-once / events (git-ignored)
STATE_DB_PATH=state/pinpoint_state.sqlite3

LOG_LEVEL=INFO

# Later phases (not used yet) --------------------------------------------
# POLL_INTERVAL_SECONDS=300
# POLL_OVERLAP_SECONDS=120
# DATABASE_URL=postgresql://user:password@localhost:5432/pinpoint_scorecards
